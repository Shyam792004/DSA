
        int n = sc.nextInt();

        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        Arrays.sort(arr); // array must be sorted
        int target = sc.nextInt();

        int l = 0;
        int r = arr.length - 1;
        boolean found = false;

        while (l < r) {
            int sum = arr[l] + arr[r];

            if (sum == target) {
                System.out.println(arr[l] + " " + arr[r]);
                found = true;
                break; // VERY IMPORTANT
            } else if (sum < target) {
                l++;
            } else {
                r--;
            }
        }

        if (!found) {
            System.out.println("No pair found");
        }
    }
}
