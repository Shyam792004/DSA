import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s1 = sc.nextLine();
        String s2 = sc.nextLine();
        
       char [] arr2=s2.toCharArray();
       Arrays.sort(arr2);
       s2=new String (arr2);
        
        
        
        int l=0;
        int r=s2.length()-1;
        for(int i=0;i<s1.length();i++)
        {
            if(r+1>s1.length())
            {
                break;
            }
            else
            {
                String str=s1.substring(l,r+1);
                
                char [] arr1=str.toCharArray();
                Arrays.sort(arr1);
                str=new String (arr1);
                
                if(str.equals(s2))
                {
                    System.out.println(l);
                    // System.out.println(s1.substring(l,r+1));
                }
                l++;
                r++;
            }
        }
        
    }
}
