        int l=0;
        for(int i=-n;i<=n;i++)
        {
            if(i<0)
            {
                l=-i;
            }
            else{
                l=i;
            }
           
            for(int j=0;j<(n-l)+1;j++)
            {
                System.out.print("* ");
            }
            System.out.println();
        }
