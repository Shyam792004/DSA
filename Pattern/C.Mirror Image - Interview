        int l=0;
        for(int i=-n;i<=n;i++)
        {
            if(i<0)
            {
                l=(-i);
            }
            else
            {
                l=i;
            }
            for(int j=0;j<n+1;j++)
            {
                if(j<(n-l))//space formula shpuld applied here
                {
                System.out.print(" ");
                }
                else{
                System.out.print("* ");
                }
            }
            
            System.out.println();
        }
