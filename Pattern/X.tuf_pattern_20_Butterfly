import java.util.*;
class Main
{
    
    public static void main(String [] args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
                
                for(int i=0;i<=n;i++)////---------0 to =n is important for up and down arrow sums
        {
            for(int j=0;j<i+1;j++)
            {
                System.out.print("*");
            }
            for(int s=0;s<2*n-(2*i);s++)
            {
                System.out.print(" ");
            }
            for(int j=0;j<i+1;j++)
            {
                System.out.print("*");
            }

            System.out.println();
        }
       
        for(int i=1;i<=n;i++) //i=1 is important for proper butter fly
        {
            for(int j=0;j<(n-i)+1;j++)
            {
                System.out.print("*");
            }
            for(int s=0;s<2*i;s++)
            {
                System.out.print(" ");
            }
            for(int j=0;j<(n-i)+1;j++)
            {
                System.out.print("*");
            }
            
            
            System.out.println();
        }
    }
}
