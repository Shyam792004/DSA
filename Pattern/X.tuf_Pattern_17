        for(int i=0;i<n;i++)
        {
            
            for(int s=0;s<(n-i)-1;s++)
            {
                System.out.print(" ");
            }
            char ch='A';
            int breakpoint=((i*2)+1)/2;
            for(int j=0;j<(i*2)+1;j++)
            {
                System.out.print(ch);
                if(j<breakpoint)
                {
                    ch++;
                }
                else
                {
                    ch--;
                }
            }
            
            
            System.out.println();
        }
