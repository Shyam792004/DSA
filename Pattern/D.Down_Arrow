
        int l=0;
        for(int i=0;i<=n;i++)
        {
            for(int j=-n;j<=n;j++)
            {
                if(-(n-i)<j && j<(n-i))
                {
                    System.out.print("  ");
                }
                else
                {
                    System.out.print("* ");
                }
            }
            System.out.println();
        }
    
