
        
        int l=0;
        for(int i=-n;i<=n;i++)
        {
            if(i<0)
            {
                l=(-i);
            }
            else
            {
                l=i;
            }
            for(int j=0;j<n+1;j++)
            {
                if(j<n-l)    //always s value
                System.out.print(" ");
                else
                System.out.print("*");
            }
            System.out.println();
        }
  
