        int l=0;
        for(int i=-n;i<=n;i++)
        {
            if(i<0)
            {
                l=(-i);
            }
            else
            {
                l=i;
            }
            for(int s=0;s<l;s++)
            {
                System.out.print("  ");
            }
            for(int j=0;j<(2*n)-((2*l)+1);j++)
            {
                System.out.print("* ");
            }
            System.out.println();
        }
