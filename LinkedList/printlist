import java.util.*;

class LinkedList
{
    private Node head;
    private Node tail;
    private int length;
    class Node
    {
        int value;
        Node nxt;
        Node(int value)
        {
            this.value=value;
        }
        
    }
    public LinkedList(int value)
    {
        Node nn=new Node(value);
        head=nn;
        tail=nn;
        length++;
    }
    public void printList()
    {
        Node temp=head;
        while(temp!=null)
        {
            System.out.print(temp.value);
            temp=temp.nxt;
        }
    }
    public void getHead()
    {
        System.out.println(head.value);
    }
    public void getTail()
    {
        System.out.println(tail.value);
    }
    public void getLength()
    {
        System.out.println(length);
    }
}
public class Main
{
    
	public static void main(String[] args) 
	{
	   LinkedList ll=new LinkedList(4);
	   ll.getHead();
	   ll.getTail();
	   ll.getLength();
	   ll.printList();
	}
}
