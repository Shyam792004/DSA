import java.util.*;
class Main
{
    public static int findSqrtOfNumber(int n,int m)
    {
        int l=0;
        int r=m;
        
        while(l<=r)
        {
            int mid=l+(r-l)/2;
            if(Math.pow(mid,n)==m)
            {
                return mid;
            }
            else if(Math.pow(mid,n)<m)
            {
                l=mid+1;
            }
            else{
                r=mid-1;
            }
        }
        return -1;
    }
    public static void main(String [] args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();//3
        int m=sc.nextInt();//27

        int number=findSqrtOfNumber(n,m);
        System.out.print(n+"root of the number is : "+number);
    }
}
