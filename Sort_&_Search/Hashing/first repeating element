import java.util.*;
class Main 
{
    public static void main(String [] args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
        
        HashMap<Integer,Integer>mp=new LinkedHashMap<>();
        
        for(int i:arr)
        {
            if(mp.containsKey(i))
            {
                System.out.println(i);
            }
            else{
                mp.put(i,mp.getOrDefault(i,0)+1);
            }
        }
        
        
    }
}
