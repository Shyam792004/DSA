import java.util.*;
class Main 
{
    static int[] nextGreaterNumber(int [] arr,int n)
    {
        Stack<Integer>sk=new Stack<>();
        
        int res[]=new int[n];
        for(int i=n-1;i>=0;i--)
        {
            while(!sk.isEmpty() && sk.peek()<arr[i])
            {
              sk.pop();
            }
            res[i]=sk.isEmpty()?-1:sk.peek();
            sk.push(arr[i]);
        }
        return res;
    }
    public static void main(String [] args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
        
        int [] ans=nextGreaterNumber(arr,n);
        System.out.println(Arrays.toString(ans));
    }
}
