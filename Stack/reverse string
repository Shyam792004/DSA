String str=sc.nextLine();
        Stack<Character>sk=new Stack<>();
        
        for(char c:str.toCharArray())
        {
            sk.push(c);
        }
        StringBuilder sb=new StringBuilder();
        
        while(!sk.isEmpty())
        {
            sb.append(sk.pop());
        }
        
        
        System.out.println(sb.toString());
