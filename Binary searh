public stati Boolean binarySearh(int []arr,int k)
{
    int left=0;
    int right=arr.length-1;

   
    while(left<=right)
    {
      int mid=(left+right)/2;
      
      if(mid==k)
      {
       return true;
      }
      //k greater than mid then update left to mid+1;
      if(arr[mid]<k)
      {
        left=mid+1;
      }
      else
      {
        right=mid-1;
      }
}
return false;
